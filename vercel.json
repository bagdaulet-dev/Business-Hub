{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-static.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/search.js": {
      "maxDuration": 60,
      "includeFiles": "data/demo/**"
    },
    "api/recommend.js": {
      "maxDuration": 60,
      "includeFiles": "data/demo/**"
    }
  }
}
